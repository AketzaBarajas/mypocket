# Copia este archivo como .env.local y rellena los valores.
# Ninguna de estas variables es un secreto: acaban en el bundle público.

# ID de cliente OAuth de Google (tipo «Aplicación web») para las copias en Drive.
# Se crea en Google Cloud Console; ver docs/SETUP.md, paso 3.
VITE_GOOGLE_CLIENT_ID=

# Opcional. Orígenes wss:// de relays propios, separados por comas, que la CSP
# debe permitir además del relay gratuito de Evolu (wss://free.evoluhq.com).
VITE_RELAY_ORIGINS=
